<?xml version="1.0" ?>
<!-- Husky (0.5x) + RoArm-M3 Complete Mobile Manipulator -->
<!-- Total DOF: 4 (wheels) + 6 (arm) = 10 DOF -->
<robot name="HuskyRoArmComplete">

  <!-- ========== HUSKY BASE (0.5x scale) ========== -->
  
  <link name="base_footprint"/>
  
  <link name="base_link">
    <inertial>
      <mass value="25.0"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.5" ixy="0" ixz="0" iyy="1.375" iyz="0" izz="1.5"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="/home/roarm_m3/roarm_isaac_clean/assets/husky/husky_ros/husky_description/meshes/base_link.dae" scale="0.5 0.5 0.5"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <geometry>
        <box size="0.495 0.335 0.10"/>
      </geometry>
    </collision>
  </link>
  
  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0.0825" rpy="0 0 0"/>
  </joint>
  
  <!-- Top chassis -->
  <link name="top_chassis_link">

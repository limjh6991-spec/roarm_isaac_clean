    <child link="link3" />
    <axis xyz="0.0 0.0 1.0" />
    <limit lower="-1.0" upper="2.95" effort="5.0" velocity="3.0" />
    <dynamics damping="0.32" friction="0.05" />
  </joint>
  <joint name="link3_to_link4" type="revolute">

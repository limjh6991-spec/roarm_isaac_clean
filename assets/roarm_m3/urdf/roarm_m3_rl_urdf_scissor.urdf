<?xml version="1.0"?>
<robot name="roarm_m3" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ========================
       GLOBAL MATERIALS
       ======================== -->
  <material name="black"><color rgba="0.1 0.1 0.1 1"/></material>
  <material name="grey"><color rgba="0.5 0.5 0.5 1"/></material>
  <material name="red"><color rgba="0.8 0.1 0.1 1"/></material>

  <!-- ========================
       BASE LINK
       ======================== -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.02" rpy="0 0 0"/>
      <geometry><cylinder radius="0.06" length="0.04"/></geometry>
      <material name="black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.02" rpy="0 0 0"/>
      <geometry><cylinder radius="0.06" length="0.04"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.02" rpy="0 0 0"/>
      <mass value="0.6"/> <!-- TODO: set real mass -->
      <inertia ixx="3e-3" iyy="3e-3" izz="3e-3" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <!-- ========================
       J1: BASE YAW (360°)
       ======================== -->
  <joint name="joint1_base_yaw" type="revolute">
    <parent link="base_link"/>
    <child  link="link1_shoulder_base"/>
    <origin xyz="0 0 0.04" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <!-- 베이스 360° 회전 가능 → [-π, π] 근사 -->
    <limit lower="-3.1416" upper="3.1416" effort="30.0" velocity="2.5"/>
    <dynamics damping="0.05" friction="0.02"/>
  </joint>

  <link name="link1_shoulder_base">
    <visual>
      <origin xyz="0 0 0.06" rpy="0 0 0"/>
      <geometry><cylinder radius="0.05" length="0.12"/></geometry>
      <material name="grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.06" rpy="0 0 0"/>
      <geometry><cylinder radius="0.05" length="0.12"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.06" rpy="0 0 0"/>
      <mass value="0.35"/> <!-- TODO -->
      <inertia ixx="8e-4" iyy="8e-4" izz="8e-4" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <!-- ========================
       J2: SHOULDER PITCH (~180°)
       ======================== -->
  <joint name="joint2_shoulder_pitch" type="revolute">
    <parent link="link1_shoulder_base"/>
    <child  link="link2_upper_arm"/>
    <origin xyz="0 0 0.12" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <!-- 어깨 약 180° 범위 → [-90°, +90°] -->
    <limit lower="-1.5708" upper="1.5708" effort="25.0" velocity="2.0"/>
    <dynamics damping="0.05" friction="0.02"/>
  </joint>

  <link name="link2_upper_arm">
    <visual>
      <origin xyz="0 0 0.16" rpy="0 0 0"/>
      <geometry><cylinder radius="0.035" length="0.32"/></geometry> <!-- 0.32m 상완 -->
      <material name="grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.16" rpy="0 0 0"/>
      <geometry><cylinder radius="0.035" length="0.32"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.16" rpy="0 0 0"/>
      <mass value="0.25"/> <!-- TODO -->
      <inertia ixx="5e-4" iyy="5e-4" izz="2e-4" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <!-- ========================
       J3: ELBOW PITCH (~225°)
       ======================== -->
  <joint name="joint3_elbow_pitch" type="revolute">
    <parent link="link2_upper_arm"/>
    <child  link="link3_forearm"/>
    <origin xyz="0 0 0.32" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <!-- 팔꿈치 약 225° → [-180°, +45°] 가이드 -->
    <limit lower="-3.1416" upper="0.7854" effort="25.0" velocity="2.0"/>
    <dynamics damping="0.05" friction="0.02"/>
  </joint>

  <link name="link3_forearm">
    <visual>
      <origin xyz="0 0 0.16" rpy="0 0 0"/>
      <geometry><cylinder radius="0.03" length="0.32"/></geometry> <!-- 0.32m 전완 -->
      <material name="grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.16" rpy="0 0 0"/>
      <geometry><cylinder radius="0.03" length="0.32"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.16" rpy="0 0 0"/>
      <mass value="0.22"/> <!-- TODO -->
      <inertia ixx="4e-4" iyy="4e-4" izz="2e-4" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <!-- ========================
       J4: WRIST PITCH (~135°)
       ======================== -->
  <joint name="joint4_wrist_pitch" type="revolute">
    <parent link="link3_forearm"/>
    <child  link="link4_wrist_pitch"/>
    <origin xyz="0 0 0.32" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <!-- 손목 피치 약 135° → [-67.5°, +67.5°] -->
    <limit lower="-1.1781" upper="1.1781" effort="15.0" velocity="2.5"/>
    <dynamics damping="0.03" friction="0.015"/>
  </joint>

  <link name="link4_wrist_pitch">
    <visual>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <geometry><cylinder radius="0.025" length="0.10"/></geometry>
      <material name="grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <geometry><cylinder radius="0.025" length="0.10"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <mass value="0.12"/> <!-- TODO -->
      <inertia ixx="1.5e-4" iyy="1.5e-4" izz="1.0e-4" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <!-- ========================
       J5: WRIST ROLL (~270°)
       ======================== -->
  <joint name="joint5_wrist_roll" type="revolute">
    <parent link="link4_wrist_pitch"/>
    <child  link="ee_link"/>
    <origin xyz="0 0 0.10" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <!-- 손목 롤 약 270° → [-135°, +135°] -->
    <limit lower="-2.3562" upper="2.3562" effort="10.0" velocity="3.0"/>
    <dynamics damping="0.03" friction="0.01"/>
  </joint>

  <link name="ee_link">
    <visual>
      <origin xyz="0 0 0.015" rpy="0 0 0"/>
      <geometry><box size="0.04 0.04 0.03"/></geometry>
      <material name="black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.015" rpy="0 0 0"/>
      <geometry><box size="0.04 0.04 0.03"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.015" rpy="0 0 0"/>
      <mass value="0.08"/> <!-- TODO -->
      <inertia ixx="8e-5" iyy="8e-5" izz="8e-5" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <!-- ========================
       SCISSOR GRIPPER (REVOLUTE x2 + mimic)
       ======================== -->

  <!-- left finger link -->
  <link name="left_finger_link">
    <visual>
      <origin xyz="0 0 0.03" rpy="0 0 0"/>
      <geometry><box size="0.012 0.008 0.06"/></geometry>
      <material name="grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.03" rpy="0 0 0"/>
      <geometry><box size="0.012 0.008 0.06"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.03" rpy="0 0 0"/>
      <mass value="0.03"/>
      <inertia ixx="2.5e-5" iyy="2.5e-5" izz="1.0e-5" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <!-- right finger link -->
  <link name="right_finger_link">
    <visual>
      <origin xyz="0 0 0.03" rpy="0 0 0"/>
      <geometry><box size="0.012 0.008 0.06"/></geometry>
      <material name="grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.03" rpy="0 0 0"/>
      <geometry><box size="0.012 0.008 0.06"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.03" rpy="0 0 0"/>
      <mass value="0.03"/>
      <inertia ixx="2.5e-5" iyy="2.5e-5" izz="1.0e-5" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <!-- main drive: left hinge (rotate inward when cmd<0) -->
  <joint name="gripper_left_hinge" type="revolute">
    <parent link="ee_link"/>
    <child  link="left_finger_link"/>
    <!-- 힌지 위치: EE 양옆 12~15mm 가정 -->
    <origin xyz="0 0.015 0.01" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <!-- 닫힘/펼침 각도: -30° ~ +10° -->
    <limit lower="-0.5236" upper="0.1745" effort="5.0" velocity="3.0"/>
    <dynamics damping="0.02" friction="0.02"/>
  </joint>

  <!-- slave: right hinge mimic (opposite sign) -->
  <joint name="gripper_right_hinge" type="revolute">
    <parent link="ee_link"/>
    <child  link="right_finger_link"/>
    <origin xyz="0 -0.015 0.01" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-0.5236" upper="0.1745" effort="5.0" velocity="3.0"/>
    <dynamics damping="0.02" friction="0.02"/>
    <!-- 좌측과 반대 방향으로 동기화 -->
    <mimic joint="gripper_left_hinge" multiplier="-1.0" offset="0.0"/>
  </joint>

  <!-- (선택) ROS control用 transmission 템플릿: 필요 시 컨트롤러에 맞춰 수정
  <transmission name="trans_joint1">
    <type>transmission_interface/SimpleTransmission</type>
    <actuator name="motor1"><mechanicalReduction>1</mechanicalReduction></actuator>
    <joint name="joint1_base_yaw"/>
  </transmission>
  -->

</robot>

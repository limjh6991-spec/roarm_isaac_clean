<?xml version="1.0" ?>
<!--
RoArm-M3 URDF (RL-Ready Version - Waveshare Official Spec)
강화학습용 완전판 - 2025-10-21 Updated

📋 Waveshare 공식 스펙 반영:
- 5+1 DOF 로봇 암 (팔 5개 관절 + 그리퍼 1개)
- 작업 반경: 직경 1m (반경 0.5m)
- 페이로드: 0.2kg @ 0.5m 거리
- 서보: ST3215 (12-bit 정밀도 0.088°)
- 듀얼 드라이브: Shoulder 관절 (토크 2배)

주요 개선사항:
1. Waveshare 공식 관절 범위 적용 (Base 360°, Shoulder 180°, etc.)
2. 2핑거 prismatic 그리퍼 (0-30mm, mimic 관계)
3. 실제 중량 기반 mass/inertia (총 중량 ~1.5kg)
4. Collision/visual 완전 분리 (PhysX 최적화)
5. Self-collision 회피 설정
6. 정확한 링크 길이 (Upper arm 160mm, Forearm 160mm)
-->
<robot name="roarm_m3_rl">
  
  <!-- ============================================ -->
  <!-- Materials -->
  <!-- ============================================ -->
  <material name="black">
    <color rgba="0.1 0.1 0.1 1.0"/>
  </material>
  <material name="dark_gray">
    <color rgba="0.3 0.3 0.3 1.0"/>
  </material>
  <material name="silver">
    <color rgba="0.7 0.7 0.75 1.0"/>
  </material>
  <material name="gray">
    <color rgba="0.5 0.5 0.5 1.0"/>
  </material>
  <material name="red">
    <color rgba="0.8 0.2 0.2 1.0"/>
  </material>
  
  <!-- ============================================ -->
  <!-- World Link (Fixed Base) -->
  <!-- ============================================ -->
  <link name="world"/>
  
  <!-- ============================================ -->
  <!-- Base Link -->
  <!-- ============================================ -->
  <link name="base_link">
    <!-- Visual: 베이스 플랫폼 (90x90x20mm) -->
    <visual>
      <origin xyz="0 0 0.01" rpy="0 0 0"/>
      <geometry>
        <box size="0.09 0.09 0.02"/>
      </geometry>
      <material name="dark_gray"/>
    </visual>
    
    <!-- Visual: 중앙 허브 (직경 50mm, 높이 20mm) -->
    <visual>
      <origin xyz="0 0 0.03" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.025" length="0.02"/>
      </geometry>
      <material name="black"/>
    </visual>
    
    <!-- Collision: 단순화된 박스 -->
    <collision>
      <origin xyz="0 0 0.02" rpy="0 0 0"/>
      <geometry>
        <box size="0.09 0.09 0.04"/>
      </geometry>
    </collision>
    
    <!-- Inertial: 베이스 질량 500g -->
    <inertial>
      <mass value="0.500"/>
      <origin xyz="0 0 0.02" rpy="0 0 0"/>
      <inertia ixx="0.000400" iyy="0.000400" izz="0.000500" 
               ixy="0.0" ixz="0.0" iyz="0.0"/>
    </inertial>
  </link>
  
  <!-- ============================================ -->
  <!-- Joint 1: Base Rotation (Z-axis, 360°) -->
  <!-- Waveshare Spec: 전방향 360° 회전 -->
  <!-- ============================================ -->
  <joint name="joint_1" type="revolute">
    <parent link="base_link"/>
    <child link="link_1"/>
    <origin xyz="0 0 0.04" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>  <!-- Z축 회전 -->
    <limit lower="-3.14159" upper="3.14159" effort="15.0" velocity="2.5"/>
    <dynamics damping="1.0" friction="0.5"/>
  </joint>
  
  <!-- ============================================ -->
  <!-- Link 1: Shoulder Turret -->
  <!-- ============================================ -->
  <link name="link_1">
    <!-- Visual: 메인 실린더 (직경 50mm, 높이 80mm) -->
    <visual>
      <origin xyz="0 0 0.04" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.025" length="0.08"/>
      </geometry>
      <material name="black"/>
    </visual>
    
    <!-- Visual: 상단 플레이트 (40x40x10mm) -->
    <visual>
      <origin xyz="0 0 0.085" rpy="0 0 0"/>
      <geometry>
        <box size="0.04 0.04 0.01"/>
      </geometry>
      <material name="silver"/>
    </visual>
    
    <!-- Collision -->
    <collision>
      <origin xyz="0 0 0.045" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.026" length="0.09"/>
      </geometry>
    </collision>
    
    <!-- Inertial: 300g -->
    <inertial>
      <mass value="0.300"/>
      <origin xyz="0 0 0.045" rpy="0 0 0"/>
      <inertia ixx="0.000250" iyy="0.000250" izz="0.000200" 
               ixy="0.0" ixz="0.0" iyz="0.0"/>
    </inertial>
  </link>
  
  <!-- ============================================ -->
  <!-- Joint 2: Shoulder (Y-axis, 180°) -->
  <!-- Waveshare Spec: -90° ~ +90° (듀얼 드라이브, 토크 2배) -->
  <!-- ============================================ -->
  <joint name="joint_2" type="revolute">
    <parent link="link_1"/>
    <child link="link_2"/>
    <origin xyz="0 0 0.09" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>  <!-- Y축 회전 (pitch) -->
    <limit lower="-1.5708" upper="1.5708" effort="40.0" velocity="2.0"/>  <!-- 듀얼 드라이브: effort 2배 -->
    <dynamics damping="0.8" friction="0.4"/>
  </joint>
  
  <!-- ============================================ -->
  <!-- Link 2: Upper Arm -->
  <!-- ============================================ -->
  <link name="link_2">
    <!-- Visual: 메인 암 (직경 44mm, 길이 160mm) -->
    <visual>
      <origin xyz="0.08 0 0" rpy="0 1.5708 0"/>
      <geometry>
        <cylinder radius="0.022" length="0.16"/>
      </geometry>
      <material name="silver"/>
    </visual>
    
    <!-- Visual: 조인트 커버 (직경 36mm) -->
    <visual>
      <origin xyz="0.0 0 0" rpy="0 1.5708 0"/>
      <geometry>
        <cylinder radius="0.018" length="0.04"/>
      </geometry>
      <material name="black"/>
    </visual>
    
    <!-- Visual: 엘보 조인트 박스 -->
    <visual>
      <origin xyz="0.16 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.04 0.04 0.04"/>
      </geometry>
      <material name="dark_gray"/>
    </visual>
    
    <!-- Collision: 캡슐 형태 (마찰 감소) -->
    <collision>
      <origin xyz="0.08 0 0" rpy="0 1.5708 0"/>
      <geometry>
        <cylinder radius="0.024" length="0.16"/>
      </geometry>
    </collision>
    
    <!-- Inertial: 250g -->
    <inertial>
      <mass value="0.250"/>
      <origin xyz="0.08 0 0" rpy="0 0 0"/>
      <inertia ixx="0.000300" iyy="0.001800" izz="0.001800" 
               ixy="0.0" ixz="0.0" iyz="0.0"/>
    </inertial>
  </link>
  
  <!-- ============================================ -->
  <!-- Joint 3: Elbow (Y-axis, 180°+) -->
  <!-- Waveshare Spec: 약 225° 범위 -->
  <!-- ============================================ -->
  <joint name="joint_3" type="revolute">
    <parent link="link_2"/>
    <child link="link_3"/>
    <origin xyz="0.16 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>  <!-- Y축 회전 -->
    <limit lower="-3.14159" upper="0.7854" effort="15.0" velocity="2.0"/>  <!-- -180° ~ +45° -->
    <dynamics damping="0.6" friction="0.35"/>
  </joint>
  
  <!-- ============================================ -->
  <!-- Link 3: Forearm -->
  <!-- ============================================ -->
  <link name="link_3">
    <!-- Visual: 포암 (직경 40mm, 길이 150mm) -->
    <visual>
      <origin xyz="0.075 0 0" rpy="0 1.5708 0"/>
      <geometry>
        <cylinder radius="0.020" length="0.15"/>
      </geometry>
      <material name="black"/>
    </visual>
    
    <!-- Visual: 내부 튜브 (직경 32mm) -->
    <visual>
      <origin xyz="0.075 0 0" rpy="0 1.5708 0"/>
      <geometry>
        <cylinder radius="0.016" length="0.14"/>
      </geometry>
      <material name="silver"/>
    </visual>
    
    <!-- Visual: 손목 조인트 박스 -->
    <visual>
      <origin xyz="0.15 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.03 0.035 0.035"/>
      </geometry>
      <material name="dark_gray"/>
    </visual>
    
    <!-- Collision -->
    <collision>
      <origin xyz="0.075 0 0" rpy="0 1.5708 0"/>
      <geometry>
        <cylinder radius="0.021" length="0.15"/>
      </geometry>
    </collision>
    
    <!-- Inertial: 200g -->
    <inertial>
      <mass value="0.200"/>
      <origin xyz="0.075 0 0" rpy="0 0 0"/>
      <inertia ixx="0.000250" iyy="0.000600" izz="0.000600" 
               ixy="0.0" ixz="0.0" iyz="0.0"/>
    </inertial>
  </link>
  
  <!-- ============================================ -->
  <!-- Joint 4: Wrist Pitch (Y-axis, 180°) -->
  <!-- Waveshare Spec: -90° ~ +90° -->
  <!-- ============================================ -->
  <joint name="joint_4" type="revolute">
    <parent link="link_3"/>
    <child link="link_4"/>
    <origin xyz="0.15 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>  <!-- Y축 회전 -->
    <limit lower="-1.5708" upper="1.5708" effort="10.0" velocity="2.5"/>
    <dynamics damping="0.5" friction="0.3"/>
  </joint>
  
  <!-- ============================================ -->
  <!-- Link 4: Wrist Connector -->
  <!-- ============================================ -->
  <link name="link_4">
    <!-- Visual: 손목 연결부 (직경 36mm, 높이 60mm) -->
    <visual>
      <origin xyz="0 0 0.03" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.018" length="0.06"/>
      </geometry>
      <material name="silver"/>
    </visual>
    
    <!-- Visual: 내부 구동부 -->
    <visual>
      <origin xyz="0 0 0.02" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.015" length="0.04"/>
      </geometry>
      <material name="black"/>
    </visual>
    
    <!-- Collision -->
    <collision>
      <origin xyz="0 0 0.03" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.019" length="0.06"/>
      </geometry>
    </collision>
    
    <!-- Inertial: 150g -->
    <inertial>
      <mass value="0.150"/>
      <origin xyz="0 0 0.03" rpy="0 0 0"/>
      <inertia ixx="0.000100" iyy="0.000100" izz="0.000080" 
               ixy="0.0" ixz="0.0" iyz="0.0"/>
    </inertial>
  </link>
  
  <!-- ============================================ -->
  <!-- Joint 5: Wrist Roll (Z-axis, 360°) -->
  <!-- Waveshare Spec: 전체 360° 회전 -->
  <!-- ============================================ -->
  <joint name="joint_5" type="revolute">
    <parent link="link_4"/>
    <child link="link_5"/>
    <origin xyz="0 0 0.06" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>  <!-- Z축 회전 (roll) -->
    <limit lower="-3.14159" upper="3.14159" effort="8.0" velocity="3.0"/>
    <dynamics damping="0.4" friction="0.25"/>
  </joint>
  
  <!-- ============================================ -->
  <!-- Link 5: Wrist Rotator -->
  <!-- ============================================ -->
  <link name="link_5">
    <!-- Visual: 회전 허브 (직경 40mm, 높이 50mm) -->
    <visual>
      <origin xyz="0 0 0.025" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.020" length="0.05"/>
      </geometry>
      <material name="black"/>
    </visual>
    
    <!-- Visual: 상단 플랜지 -->
    <visual>
      <origin xyz="0 0 0.055" rpy="0 0 0"/>
      <geometry>
        <box size="0.035 0.035 0.01"/>
      </geometry>
      <material name="dark_gray"/>
    </visual>
    
    <!-- Collision -->
    <collision>
      <origin xyz="0 0 0.03" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.021" length="0.06"/>
      </geometry>
    </collision>
    
    <!-- Inertial: 100g -->
    <inertial>
      <mass value="0.100"/>
      <origin xyz="0 0 0.03" rpy="0 0 0"/>
      <inertia ixx="0.000080" iyy="0.000080" izz="0.000050" 
               ixy="0.0" ixz="0.0" iyz="0.0"/>
    </inertial>
  </link>
  
  <!-- ============================================ -->
  <!-- Gripper Base Connection (Fixed) -->
  <!-- Waveshare Spec: 5+1 DOF (5개 팔 관절 + 1개 그리퍼) -->
  <!-- ============================================ -->
  <joint name="gripper_base_joint" type="fixed">
    <parent link="link_5"/>
    <child link="gripper_base"/>
    <origin xyz="0 0 0.06" rpy="0 0 0"/>
  </joint>
  
  <!-- ============================================ -->
  <!-- Gripper Base (그리퍼 베이스 - 가위형 구조) -->
  <!-- Waveshare Spec: 135° 개방각 (약 0.52 rad) -->
  <!-- ============================================ -->
  <link name="gripper_base">
    <!-- Visual: 메인 하우징 (원통형) -->
    <visual>
      <origin xyz="0 0 0.015" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.020" length="0.030"/>
      </geometry>
      <material name="dark_gray"/>
    </visual>
    
    <!-- Visual: 힌지 플레이트 (좌측) -->
    <visual>
      <origin xyz="0 0.012 0.020" rpy="0 0 0"/>
      <geometry>
        <box size="0.010 0.008 0.010"/>
      </geometry>
      <material name="silver"/>
    </visual>
    
    <!-- Visual: 힌지 플레이트 (우측) -->
    <visual>
      <origin xyz="0 -0.012 0.020" rpy="0 0 0"/>
      <geometry>
        <box size="0.010 0.008 0.010"/>
      </geometry>
      <material name="silver"/>
    </visual>
    
    <!-- Collision: 단순화된 원통 -->
    <collision>
      <origin xyz="0 0 0.015" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.022" length="0.030"/>
      </geometry>
    </collision>
    
    <!-- Inertial: 50g -->
    <inertial>
      <mass value="0.050"/>
      <origin xyz="0 0 0.015" rpy="0 0 0"/>
      <inertia ixx="0.000020" iyy="0.000025" izz="0.000030" 
               ixy="0.0" ixz="0.0" iyz="0.0"/>
    </inertial>
  </link>
  
  <!-- ============================================ -->
  <!-- Left Finger (왼쪽 핑거 - 가위형 회전) -->
  <!-- ============================================ -->
  <link name="gripper_left_finger">
    <!-- Visual: 핑거 암 (길이 40mm, 폭 8mm) -->
    <visual>
      <origin xyz="0 0 0.020" rpy="0 0 0"/>
      <geometry>
        <box size="0.008 0.006 0.040"/>
      </geometry>
      <material name="black"/>
    </visual>
    
    <!-- Visual: 핑거 팁 (접촉면) -->
    <visual>
      <origin xyz="0 0 0.042" rpy="0 0 0"/>
      <geometry>
        <box size="0.012 0.008 0.008"/>
      </geometry>
      <material name="silver"/>
    </visual>
    
    <!-- Visual: 접촉 패드 (고마찰) -->
    <visual>
      <origin xyz="0 -0.003 0.042" rpy="0 0 0"/>
      <geometry>
        <box size="0.010 0.002 0.006"/>
      </geometry>
      <material name="red"/>
    </visual>
    
    <!-- Collision: 복합 형태 (암 + 팁) -->
    <collision>
      <origin xyz="0 0 0.020" rpy="0 0 0"/>
      <geometry>
        <box size="0.010 0.008 0.040"/>
      </geometry>
    </collision>
    <collision>
      <origin xyz="0 0 0.042" rpy="0 0 0"/>
      <geometry>
        <box size="0.012 0.010 0.008"/>
      </geometry>
    </collision>
    
    <!-- Inertial: 15g -->
    <inertial>
      <mass value="0.015"/>
      <origin xyz="0 0 0.025" rpy="0 0 0"/>
      <inertia ixx="0.000003" iyy="0.000003" izz="0.000001" 
               ixy="0.0" ixz="0.0" iyz="0.0"/>
    </inertial>
  </link>
  
  <!-- ============================================ -->
  <!-- Left Finger Joint (Revolute - 가위형) -->
  <!-- Waveshare Spec: 135° 개방각 (3.14 ~ 1.08 rad) -->
  <!-- ============================================ -->
  <joint name="gripper_left_joint" type="revolute">
    <parent link="gripper_base"/>
    <child link="gripper_left_finger"/>
    <origin xyz="0 0.012 0.020" rpy="0 0 0"/>  <!-- 힌지 위치 -->
    <axis xyz="1 0 0"/>  <!-- X축 회전 (가위 동작) -->
    <limit lower="-0.52" upper="0.52" effort="10.0" velocity="1.5"/>  <!-- ±30° (총 60°) -->
    <dynamics damping="0.5" friction="0.3"/>
  </joint>
  
  <!-- ============================================ -->
  <!-- Right Finger (오른쪽 핑거 - 가위형 대칭) -->
  <!-- ============================================ -->
  <link name="gripper_right_finger">
    <!-- Visual: 핑거 암 (좌측과 대칭) -->
    <visual>
      <origin xyz="0 0 0.020" rpy="0 0 0"/>
      <geometry>
        <box size="0.008 0.006 0.040"/>
      </geometry>
      <material name="black"/>
    </visual>
    
    <!-- Visual: 핑거 팁 -->
    <visual>
      <origin xyz="0 0 0.042" rpy="0 0 0"/>
      <geometry>
        <box size="0.012 0.008 0.008"/>
      </geometry>
      <material name="silver"/>
    </visual>
    
    <!-- Visual: 접촉 패드 (고마찰) -->
    <visual>
      <origin xyz="0 0.003 0.042" rpy="0 0 0"/>  <!-- 우측은 +방향 -->
      <geometry>
        <box size="0.010 0.002 0.006"/>
      </geometry>
      <material name="red"/>
    </visual>
    
    <!-- Collision: 복합 형태 (암 + 팁) -->
    <collision>
      <origin xyz="0 0 0.020" rpy="0 0 0"/>
      <geometry>
        <box size="0.010 0.008 0.040"/>
      </geometry>
    </collision>
    <collision>
      <origin xyz="0 0 0.042" rpy="0 0 0"/>
      <geometry>
        <box size="0.012 0.010 0.008"/>
      </geometry>
    </collision>
    
    <!-- Inertial: 15g -->
    <inertial>
      <mass value="0.015"/>
      <origin xyz="0 0 0.025" rpy="0 0 0"/>
      <inertia ixx="0.000003" iyy="0.000003" izz="0.000001" 
               ixy="0.0" ixz="0.0" iyz="0.0"/>
    </inertial>
  </link>
  
  <!-- ============================================ -->
  <!-- Right Finger Joint (Revolute with Mimic - 가위형 대칭) -->
  <!-- Waveshare Spec: 좌측 핑거를 따라 대칭 회전 -->
  <!-- ============================================ -->
  <joint name="gripper_right_joint" type="revolute">
    <parent link="gripper_base"/>
    <child link="gripper_right_finger"/>
    <origin xyz="0 -0.012 0.020" rpy="0 0 0"/>  <!-- 힌지 위치 (우측) -->
    <axis xyz="1 0 0"/>  <!-- X축 회전 (가위 동작) -->
    <limit lower="-0.52" upper="0.52" effort="10.0" velocity="1.5"/>  <!-- ±30° -->
    <dynamics damping="0.5" friction="0.3"/>
    <mimic joint="gripper_left_joint" multiplier="-1.0" offset="0.0"/>  <!-- 반대 방향 -->
  </joint>
  
  <!-- ============================================ -->
  <!-- Fixed Joint: World to Base -->
  <!-- ============================================ -->
  <joint name="world_to_base" type="fixed">
    <parent link="world"/>
    <child link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>
  
</robot>

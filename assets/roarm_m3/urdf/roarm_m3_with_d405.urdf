<?xml version="1.0"?>
<robot name="roarm_m3_with_d405">
  <!-- RoArm-M3 with Intel RealSense D405 Camera
       - Base Robot: RoArm-M3 (6-DOF arm + 1-DOF gripper)
       - Camera: Intel RealSense D405 (mounted on gripper base)
       - Camera Position: 5cm forward, 2cm up, tilted 30° down
       - For Vision-based Pick and Place RL
  -->

  <!-- ============================================ -->
  <!-- RoArm-M3 Base Robot (from roarm_m3.generated.urdf) -->
  <!-- ============================================ -->
  
  <link name="world" />

  <link name="base_link">
    <inertial>
      <origin xyz="-0.0068 0 -0.03" rpy="0 0 0" />
      <mass value="0.2562183" />
      <inertia ixx="0.00029211" ixy="0" ixz="0" iyy="0.00035719" iyz="0" izz="0.000349421" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="../meshes/roarm_m3/base_link.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="../meshes/roarm_m3/base_link.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
  </link>

  <link name="link1">
    <inertial>
      <origin xyz="0 0 0.037" rpy="0 0 0" />
      <mass value="0.0729177" />
      <inertia ixx="4.68465E-05" ixy="0" ixz="0" iyy="3.32107E-05" iyz="0" izz="5.01023E-05" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="../meshes/roarm_m3/link1.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="../meshes/roarm_m3/link1.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
  </link>

  <link name="link2">
    <inertial>
      <origin xyz="0.119 0.012247 -0.0001" rpy="0 0 0"/>
      <mass value="0.0703216" />
      <inertia ixx="5.46501E-05" ixy="0" ixz="0" iyy="0.000423091" iyz="0" izz="0.000404557" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="../meshes/roarm_m3/link2.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="../meshes/roarm_m3/link2.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
  </link>

  <link name="link3">
    <inertial>
      <origin xyz="-0.0015 -0.0765 0.00505" rpy="0 0 0"/>
      <mass value="0.021608"/>
      <inertia ixx="6.37699E-05" iyy="3.67026E-06" izz="6.28965E-05" ixy="0" iyz="0" ixz="0"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="../meshes/roarm_m3/link3.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="../meshes/roarm_m3/link3.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
  </link>

  <link name="link4">
    <inertial>
      <origin xyz="-0.0015 -0.022 -0.00075" rpy="0 0 0"/>
      <mass value="0.0099933"/>
      <inertia ixx="4.53979E-06" iyy="3.78103E-06" izz="5.60238E-06" ixy="-0.0" iyz="-0.0" ixz="0.0"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="../meshes/roarm_m3/link4.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="../meshes/roarm_m3/link4.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
  </link>

  <link name="link5">
    <inertial>
      <origin xyz="0 0.0016 -0.016" rpy="0 0 0"/>
      <mass value="0.0481756"/>
      <inertia ixx="3.04455E-05" iyy="3.54623E-05" izz="2.21305E-05" ixy="0.0" iyz="0.0" ixz="0.0"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="../meshes/roarm_m3/link5.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="../meshes/roarm_m3/link5.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
  </link>

  <link name="gripper_link">
    <inertial>
      <origin xyz="0.0 0.00335 0.01" rpy="0 0 0"/>
      <mass value="0.028"/>
      <inertia ixx="9.45947E-06" iyy="1.00449E-05" izz="5.21351E-06" ixy="0.0" iyz="0.0" ixz="0.0"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="../meshes/roarm_m3/gripper_link.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="../meshes/roarm_m3/gripper_link.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
  </link>

  <link name="gripper_left_link">
    <inertial>
      <origin xyz="-0.00108 0 0.0175" rpy="0 0 0"/>
      <mass value="0.0030"/>
      <inertia ixx="1.54549E-06" iyy="1.53101E-06" izz="5.59953E-08" ixy="0" iyz="0" ixz="0"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="../meshes/roarm_m3/gripper_left_link.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="../meshes/roarm_m3/gripper_left_link.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
  </link>

  <!-- Joints -->
  <joint name="world_to_base" type="fixed">
    <parent link="world"/>
    <child link="base_link"/>
    <origin xyz="0.0 0.0 0.0701" rpy="0 0 0"/>
  </joint>

  <joint name="base_to_link1" type="revolute">
    <parent link="base_link"/>
    <child link="link1"/>
    <origin xyz="0 0 0.0615" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.14159" upper="3.14159" effort="10.0" velocity="3.14"/>
    <dynamics damping="0.1" friction="0.05"/>
  </joint>

  <joint name="link1_to_link2" type="revolute">
    <parent link="link1"/>
    <child link="link2"/>
    <origin xyz="0 0 0.06435" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.0" upper="1.57" effort="10.0" velocity="3.14"/>
    <dynamics damping="0.1" friction="0.05"/>
  </joint>

  <joint name="link2_to_link3" type="revolute">
    <parent link="link2"/>
    <child link="link3"/>
    <origin xyz="0.2135 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.57" upper="1.57" effort="10.0" velocity="3.14"/>
    <dynamics damping="0.1" friction="0.05"/>
  </joint>

  <joint name="link3_to_link4" type="revolute">
    <parent link="link3"/>
    <child link="link4"/>
    <origin xyz="0 -0.1457 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.57" upper="1.57" effort="10.0" velocity="3.14"/>
    <dynamics damping="0.1" friction="0.05"/>
  </joint>

  <joint name="link4_to_link5" type="revolute">
    <parent link="link4"/>
    <child link="link5"/>
    <origin xyz="0 -0.04225 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.57" upper="1.57" effort="10.0" velocity="3.14"/>
    <dynamics damping="0.1" friction="0.05"/>
  </joint>

  <joint name="link5_to_gripper_link" type="revolute">
    <parent link="link5"/>
    <child link="gripper_link"/>
    <origin xyz="0 0 -0.0435" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-0.785" upper="0.785" effort="5.0" velocity="1.57"/>
    <dynamics damping="0.1" friction="0.05"/>
  </joint>

  <joint name="gripper_link_to_left_link" type="prismatic">
    <parent link="gripper_link"/>
    <child link="gripper_left_link"/>
    <origin xyz="0 0.012 0.015" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="0.0" upper="0.02" effort="5.0" velocity="0.1"/>
    <dynamics damping="0.1" friction="0.01"/>
  </joint>

  <!-- ============================================ -->
  <!-- Intel RealSense D405 Camera -->
  <!-- ============================================ -->
  
  <!-- Camera Link (Camera Housing) -->
  <link name="camera_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.060"/>  <!-- 60g -->
      <inertia ixx="0.00001" ixy="0" ixz="0" 
               iyy="0.00001" iyz="0" 
               izz="0.00001"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.042 0.042 0.023"/>  <!-- 42x42x23mm -->
      </geometry>
      <material name="camera_black">
        <color rgba="0.15 0.15 0.15 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.042 0.042 0.023"/>
      </geometry>
    </collision>
  </link>

  <!-- Camera Mount Joint: Attach camera to gripper_link -->
  <joint name="camera_mount_joint" type="fixed">
    <parent link="gripper_link"/>
    <child link="camera_link"/>
    <!-- Position: 5cm forward, 2cm up, tilted 30° down for optimal view -->
    <origin xyz="0.05 0 0.02" rpy="0 0.5236 0"/>
  </joint>

  <!-- Camera Depth Frame -->
  <link name="camera_depth_frame"/>
  <joint name="camera_depth_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_depth_frame"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- Camera Depth Optical Frame -->
  <link name="camera_depth_optical_frame"/>
  <joint name="camera_depth_optical_joint" type="fixed">
    <parent link="camera_depth_frame"/>
    <child link="camera_depth_optical_frame"/>
    <origin xyz="0 0 0" rpy="-1.5707963267949 0 -1.5707963267949"/>
  </joint>

  <!-- Camera Color Frame -->
  <link name="camera_color_frame"/>
  <joint name="camera_color_joint" type="fixed">
    <parent link="camera_depth_frame"/>
    <child link="camera_color_frame"/>
    <origin xyz="0.0 0.0 0.0" rpy="0 0 0"/>
  </joint>

  <!-- Camera Color Optical Frame -->
  <link name="camera_color_optical_frame"/>
  <joint name="camera_color_optical_joint" type="fixed">
    <parent link="camera_color_frame"/>
    <child link="camera_color_optical_frame"/>
    <origin xyz="0 0 0" rpy="-1.5707963267949 0 -1.5707963267949"/>
  </joint>

  <!-- ============================================ -->
  <!-- Transmissions (for ROS Control) -->
  <!-- ============================================ -->

  <transmission name="base_transmission">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="base_to_link1">
      <hardwareInterface>PositionJointInterface</hardwareInterface>
    </joint>
    <actuator name="base_servo">
      <hardwareInterface>PositionJointInterface</hardwareInterface>
      <mechanicalReduction>1.0</mechanicalReduction>
    </actuator>
  </transmission>

  <transmission name="shoulder_transmission">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="link1_to_link2">
      <hardwareInterface>PositionJointInterface</hardwareInterface>
    </joint>
    <actuator name="shoulder_servo">
      <hardwareInterface>PositionJointInterface</hardwareInterface>
      <mechanicalReduction>1.0</mechanicalReduction>
    </actuator>
  </transmission>

  <transmission name="elbow_transmission">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="link2_to_link3">
      <hardwareInterface>PositionJointInterface</hardwareInterface>
    </joint>
    <actuator name="elbow_servo">
      <hardwareInterface>PositionJointInterface</hardwareInterface>
      <mechanicalReduction>1.0</mechanicalReduction>
    </actuator>
  </transmission>

  <transmission name="wrist_pitch_transmission">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="link3_to_link4">
      <hardwareInterface>PositionJointInterface</hardwareInterface>
    </joint>
    <actuator name="wrist_pitch_servo">
      <hardwareInterface>PositionJointInterface</hardwareInterface>
      <mechanicalReduction>1.0</mechanicalReduction>
    </actuator>
  </transmission>

  <transmission name="wrist_roll_transmission">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="link4_to_link5">
      <hardwareInterface>PositionJointInterface</hardwareInterface>
    </joint>
    <actuator name="wrist_roll_servo">
      <hardwareInterface>PositionJointInterface</hardwareInterface>
      <mechanicalReduction>1.0</mechanicalReduction>
    </actuator>
  </transmission>

  <transmission name="gripper_transmission">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="link5_to_gripper_link">
      <hardwareInterface>PositionJointInterface</hardwareInterface>
    </joint>
    <actuator name="gripper_servo">
      <hardwareInterface>PositionJointInterface</hardwareInterface>
      <mechanicalReduction>1.0</mechanicalReduction>
    </actuator>
  </transmission>

</robot>
